# Required for the agent (the MCP server itself needs no key)
OPENAI_API_KEY=sk-...

# Optional: model name and any OpenAI-compatible endpoint (Groq, OpenRouter, Ollama, ...)
JOBSCOUT_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Optional: where the SQLite database lives
# JOBSCOUT_DB=./data/jobscout.db
